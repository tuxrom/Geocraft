# Copier ce fichier en .env puis adapter les valeurs :  cp .env.example .env

# Domaine de base : le jeu sera servi sur https://geocraft.<DOMAIN>
DOMAIN=exemple.fr

# Port d'écoute INTERNE du conteneur (nginx). Le reverse proxy doit viser ce port.
PORT=8080

# Port publié sur l'hôte et adresse d'écoute.
# 127.0.0.1 : accessible seulement depuis le serveur (cas normal derrière un reverse proxy).
# 0.0.0.0   : accessible aussi depuis les autres conteneurs/machines via l'IP de l'hôte.
HOST_PORT=8080
BIND_ADDRESS=127.0.0.1

# Fuseau horaire des journaux
TZ=Europe/Paris

# ---- Reverse proxy dans Docker (Traefik, Nginx Proxy Manager, Caddy en conteneur) ----
# Nom du réseau Docker du reverse proxy (voir `docker network ls`).
# PROXY_NETWORK=traefik

# Pour activer l'un des fichiers de surcharge, décommenter UNE ligne :
# COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml

# Réglages Traefik (si docker-compose.traefik.yml est utilisé)
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt
