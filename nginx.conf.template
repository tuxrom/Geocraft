# Rendu au démarrage du conteneur par le script d'entrée de l'image nginx (envsubst) :
# ${PORT} vient de l'environnement. Les variables nginx ($uri...) restent intactes.
# Le conteneur n'écoute qu'en IPv4 : l'IPv6 public (enregistrement AAAA) est géré par le reverse proxy.

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # --- compression ---
    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript application/json
               application/wasm image/svg+xml font/ttf font/otf application/xml;

    # --- en-têtes de sécurité raisonnables (répétés par include : nginx n'hérite pas des add_header) ---
    include /etc/nginx/security-headers.conf;

    # --- contrôle de santé (utilisé par le HEALTHCHECK Docker) ---
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # --- fichiers hachés produits par Vite : cache d'un an, immuables ---
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/security-headers.conf;
        try_files $uri =404;
    }

    # --- page d'entrée : toujours revalidée pour récupérer les nouvelles versions du jeu ---
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
    }

    location / {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }

    # --- PWA : le service worker et le manifeste ne sont jamais mis en cache durablement ---
    location = /sw.js {
        add_header Cache-Control "no-cache" always;
        add_header Service-Worker-Allowed "/" always;
        include /etc/nginx/security-headers.conf;
    }
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
    }

    # pas d'accès aux fichiers cachés
    location ~ /\. { deny all; }
}
